{
  "key": "natural",
  "name": "Natural",
  "name_bn": "\u09aa\u09cd\u09b0\u09be\u0995\u09c3\u09a4\u09bf\u0995",
  "premise": "Six colours and no more: four natural hues, pure black and pure white. The four naturals are all primary \u2014 none is a supporting colour for the others. They are desaturated earth tones rather than screen colours, chosen so the same palette holds in print against Pantone solid coated stock as it does in sRGB. Pure black and pure white are the anchors: in the light theme the page is white and the text is black, which is the strongest pairing there is, and the surfaces between them carry a faint grey tint so depth stays visible without introducing a colour. This direction replaces Estuary, taken on 14 August 2026 and superseded on 26 August 2026 by the owner's decision to discard the old brand colours entirely.",
  "generated_by": "05_colour/engine.py",
  "warning": "Generated file. Do not hand-edit \u2014 change the direction spec and re-run.",
  "measurement": {
    "library": "coloraide",
    "contrast_method": "wcag21",
    "delta_e_method": "2000",
    "ramp_space": "oklch",
    "gamut_map": "oklch-chroma",
    "note": "Every ratio is measured on the rounded 8-bit hex, then re-measured with each channel of both colours nudged by \u00b11. The published worst_case_lsb is the lowest of those results."
  },
  "fixed": {
    "note": "Pure black and pure white are anchors, not ramps. A ramp needs eleven visibly distinct steps and neither of these has anywhere to go: black is the floor of the lightness axis and white is its ceiling. They are used directly as ink and as the brightest surface, which is what makes the light theme's body text a measured 21:1.",
    "ink_light": "#000000",
    "ink_dark": "#FFFFFF",
    "label_black": "Pure Black",
    "label_black_bn": "\u09a8\u09bf\u0996\u09be\u09a6 \u0995\u09be\u09b2\u09cb",
    "label_white": "Pure White",
    "label_white_bn": "\u09a8\u09bf\u0996\u09be\u09a6 \u09b8\u09be\u09a6\u09be"
  },
  "role_sources": {
    "warning": {
      "mode": "beyond",
      "family": "ground",
      "beyond": "ink-muted",
      "why": "The palette has no amber. Warning is Natural Gray, taken one step beyond the muted text colour so a caution is visibly heavier than quiet prose without becoming the body text colour. Owner's decision, 26 August 2026."
    },
    "info": {
      "mode": "same-as",
      "same_as": "accent",
      "why": "Natural Blue carries links, focus, the primary action and information. With four hues there is no fifth colour to distinguish a note from a link, and inventing a near-identical second blue to avoid saying so would be worse than saying so. Owner's decision, 26 August 2026."
    }
  },
  "declared_duplicates": [
    {
      "roles": [
        "ink-muted",
        "line"
      ],
      "why": "In the dark themes both resolve to Natural Gray at its own anchor, #84807C. That is the brand colour doing two jobs rather than an accident: quiet text and a border are the two places a neutral belongs, and the palette has one neutral by design. The light themes separate them \u2014 ink-muted takes a darker step there \u2014 so the collision is a property of the dark themes alone and is recorded as one."
    }
  ],
  "supersedes": {
    "direction": "estuary",
    "taken": "14 August 2026",
    "superseded": "26 August 2026",
    "why": "Owner's decision: discard and replace all old brand colours with six named colours only, and make the four natural hues primary.",
    "note": "The Estuary specification is kept in this folder as a record of what was replaced. It is no longer built into any shipped artefact \u2014 07_tokens/build.py reads this file."
